# Next.js + Supabase .gitignore

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/
/build
/dist

# Environment variables & secrets
.env
.env*.local
.env.production
.env.staging
.env.development
*.pem
*.key

# Supabase local generated / temporary artifacts
.branches
.temp
supabase/.branches
supabase/.temp

# Testing & coverage
/coverage
*.lcov

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Operating System & IDE files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Vercel & Turbo
.vercel
.turbo

# TypeScript
*.tsbuildinfo
next-env.d.ts
